# ==========================================
# MRVConsultants Environment Configuration
# ==========================================

# Formspree Configuration for Enquiry & Feedback Delivery
# Create a free form at https://formspree.io and paste your Form ID:
# e.g. FORMSPREE_FORM_ID=xpzgvwoq
FORMSPREE_FORM_ID=
# Or provide the direct submission URL:
FORMSPREE_ENDPOINT=https://formspree.io/f/mrvcconsultants

# Destination inbox where student enquiries and feedback are delivered:
FEEDBACK_TO_EMAIL=mrvcconsultants@gmail.com

# Allowed CORS origins (comma-separated). Leave EMPTY for same-origin only (recommended).
# Only list extra origins that must call the API cross-site. Arbitrary origins are never reflected.
ALLOWED_ORIGINS=

# Set to true ONLY when running behind a trusted reverse proxy that overwrites
# X-Forwarded-For / X-Real-IP (auto-enabled on Vercel). Otherwise clients could spoof
# their IP and bypass rate limiting.
TRUST_PROXY=false

# Rate limit configuration: Max requests per IP window
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=900000

# Distributed Rate Limiting via Upstash Redis (Optional for Vercel Serverless / Multi-Instance)
# Obtain free REST credentials from https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to 'redis' to fail-closed if Redis connection is unavailable in production
RATE_LIMIT_STORE=memory

# Cloudflare Turnstile Anti-Bot Protection (Optional in dev, recommended in production)
# Obtain from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Set to 'true' in production to enforce CAPTCHA verification before processing requests
REQUIRE_CAPTCHA=false

# Node.js server port (for local development or Docker / Cloud Run)
PORT=3000
